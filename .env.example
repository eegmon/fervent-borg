# ── 프론트엔드 (Vite) ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api

# ── 백엔드 서버 ───────────────────────────────────────────────────
# Turso DB  (https://app.turso.tech → 데이터베이스 → Connect)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# JWT 서명 시크릿 — openssl rand -base64 48 로 생성한 랜덤 문자열 사용
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# CORS 허용 오리진 (콤마 구분, 배포 도메인으로 교체)
# Render 기본 도메인은 RENDER_EXTERNAL_URL을 자동으로 사용하므로 생략 가능
ALLOWED_ORIGINS=http://localhost:5173

# 서버 포트 (기본 5000)
PORT=5000

# ── AI (공소사실 자동생성 / 교정) ──────────────────────────────────
# Google AI Studio (https://aistudio.google.com/apikey) 에서 발급
# Gemini Flash 무료 티어: 분당 15 req, 1일 1500 req
GEMINI_API_KEY=your_gemini_api_key_here
